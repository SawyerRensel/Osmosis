# Obsidian config (vault-specific)
.obsidian

# Reference repos
ref

# Scratch notes
scratchpad.md
prompts/

# Dolt server runtime files (not the Beads database, which is managed by .beads/.gitignore)
.dolt/

# npm
node_modules

# Build output is in vault/ (already gitignored below)

# Sourcemaps
*.map

# Obsidian plugin data (user-specific settings)
data.json

# E2E test artifacts
# vault/
.obsidian-config-e2e/
test-results/
playwright-report/

# Docs site build output
site/

# OS files
.DS_Store

# Planner task media
vault/media

# Card browser base — generated on first Browse and then edited by whoever is
# using the vault, so it churns with every layout or filter change.
vault/Osmosis/

# Review log shards — generated per-review history, one file per device.
# Regenerated by studying; committing it would churn on every session.
# (.beads/interactions.jsonl is tracked, so this is scoped to the vault.)
vault/**/*.jsonl
